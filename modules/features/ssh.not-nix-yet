yoinked from ParamantOS
https://github.com/Apolloccrypt/ParamantOS/blob/master/configuration.nix

also read https://wiki.nixos.org/wiki/SSH

verify all settings

services.openssh = {
    enable = true;

    # Ed25519 only — prevent NixOS from generating legacy RSA / ECDSA host keys
    hostKeys = [
      { type = "ed25519"; path = "/etc/ssh/ssh_host_ed25519_key"; }
    ];

    settings = {
      # ── Auth ────────────────────────────────────────────────────────────────
      PermitRootLogin              = lib.mkDefault "no";  # ISO installer overrides to "yes"
      PasswordAuthentication       = false;
      PubkeyAuthentication         = true;
      PermitEmptyPasswords         = false;
      AuthenticationMethods        = "publickey";
      KbdInteractiveAuthentication = false;
      GSSAPIAuthentication         = false;
      HostbasedAuthentication      = false;

      # ── Crypto — post-quantum hardened ──────────────────────────────────────
      # Requires OpenSSH ≥ 9.0 (NixOS 24.05+ ships ≥ 9.x).
      # ML-KEM (mlkem768x25519) mitigates store-now-decrypt-later attacks.
      KexAlgorithms            = [ "mlkem768x25519-sha256" "curve25519-sha256" "curve25519-sha256@libssh.org" ];
      Ciphers                  = [ "chacha20-poly1305@openssh.com" "aes256-gcm@openssh.com" ];
      Macs                     = [ "hmac-sha2-256-etm@openssh.com" "hmac-sha2-512-etm@openssh.com" "umac-128-etm@openssh.com" ];
      HostKeyAlgorithms        = "ssh-ed25519";
      PubkeyAcceptedAlgorithms = "ssh-ed25519,sk-ssh-ed25519@openssh.com";

      # ── DoS / connection protection ──────────────────────────────────────────
      LoginGraceTime      = 30;
      MaxAuthTries        = 3;
      MaxSessions         = 10;
      MaxStartups         = "20:50:100";
      ClientAliveInterval = 300;
      ClientAliveCountMax = 2;

      # ── Forwarding — all disabled ────────────────────────────────────────────
      AllowAgentForwarding  = false;
      AllowTcpForwarding    = "no";
      GatewayPorts          = "no";
      X11Forwarding         = false;
      PermitTunnel          = "no";
      PermitUserEnvironment = false;

      # ── Privacy & logging ────────────────────────────────────────────────────
      UseDns      = false;
      LogLevel    = "VERBOSE";
      Compression = "no";
    };

    # Per-source rate limiting (OpenSSH ≥ 8.6) — not yet in NixOS settings schema
    extraConfig = ''
      PerSourceMaxStartups 20
      PerSourceNetBlockSize 32:128
    '';
  };

  # ── Login user ─────────────────────────────────────────────────────────────
  # The relay service runs as "paramant-relay" (system user, defined in module.nix).
  # "paramant" is the human admin user who can SSH in and sudo.
  users.users.paramant = {
    isNormalUser      = true;
    description       = "Paramant admin";
    extraGroups       = [ "wheel" "networkmanager" "systemd-journal" "paramant-relay" ];
    initialPassword   = "paramant123";  # changed during paramant-setup
  };
