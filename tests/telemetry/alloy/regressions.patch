+func TestPatchOpenSegmentReusedAfterZero(t *testing.T) {
+	data := map[int]*countDataItem{0: {count: 0, lastUpdate: time.Now()}}
+	require.Equal(t, -1, findMarkableSegment(data, time.Minute))
+	require.Contains(t, data, 0)
+	data[0].count++ // Later unsent entry in the same open segment.
+	require.Equal(t, -1, findMarkableSegment(data, time.Minute))
+	data[1] = &countDataItem{count: 1, lastUpdate: time.Now()}
+	require.Equal(t, -1, findMarkableSegment(data, time.Minute))
+	data[0].count-- // Only now is the older segment resolved.
+	require.Equal(t, 0, findMarkableSegment(data, time.Minute))
+	require.NotContains(t, data, 0)
+	require.Contains(t, data, 1)
+}
+
+func TestPatchNewestSegmentDoesNotExpireIntoCheckpoint(t *testing.T) {
+	data := map[int]*countDataItem{0: {count: 2, lastUpdate: time.Now().Add(-2 * time.Hour)}}
+	require.Equal(t, -1, findMarkableSegment(data, time.Minute))
+	require.Contains(t, data, 0)
+}
+
+func TestPatchEarlyAcknowledgmentDoesNotMarkNewest(t *testing.T) {
+	data := map[int]*countDataItem{0: {count: -1, lastUpdate: time.Now()}}
+	require.Equal(t, -1, findMarkableSegment(data, time.Minute))
+	data[0].count++ // Receive registration arrives after sender completion.
+	require.Equal(t, -1, findMarkableSegment(data, time.Minute))
+	require.Contains(t, data, 0)
+	data[1] = &countDataItem{count: -1, lastUpdate: time.Now()}
+	require.Equal(t, 0, findMarkableSegment(data, time.Minute))
+	require.Contains(t, data, 1)
+}
