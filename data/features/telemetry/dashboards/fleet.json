  "panels": [
    {
      "id": 16,
      "title": "Uptime",
      "type": "bargauge",
      "description": "Successful node-exporter scrapes as a percentage of recorded scrapes within the selected dashboard range. Failed scrapes count as downtime; periods without recorded scrapes are unknown and excluded. This is sampled availability, not time since boot. The solid green bar represents successful scrapes; its unfilled remainder represents failed scrapes.",
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * avg_over_time(up{job=\"node\",host=~\"${host:regex}\"}[$__range])",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "min": 0,
          "max": 100,
          "unit": "percent",
          "decimals": 2,
          "noValue": "Unknown",
          "displayName": "${__field.labels.host}"
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      }
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "telemetry-loki"
      },
      "description": "Stacked counts of journal entries with priority 0\u20133, grouped by host and unit. Each bar covers one non-overlapping query-step bucket, at least five minutes; bucket width grows with the selected dashboard time range. Stack height is the total count. Missing unit labels are grouped as unattributed. Journal search and severity controls do not change this chart.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisLabel": "Error entries per bucket",
            "barAlignment": -1,
            "drawStyle": "bars",
            "fillOpacity": 85,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineWidth": 0,
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "decimals": 0,
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "id": 2,
      "interval": "5m",
      "maxDataPoints": 500,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (host, unit) (count_over_time({job=\"journal\",priority=~\"[0-3]\"} | label_format unit=\"{{ if .unit }}{{ .unit }}{{ else }}unattributed{{ end }}\"[$__auto]))",
          "legendFormat": "{{host}} / {{unit}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Fleet \u00b7 journal errors by source",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (host) (node_systemd_unit_state{state=\"failed\"})",
          "legendFormat": "{{host}}",
          "refId": "A"
        }
      ],
      "title": "Fleet \u00b7 failed systemd units",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "telemetry-loki"
      },
      "description": "Latest 500 matching journal entries within the dashboard time range. Defaults to warning and higher, based on journal priority, not message text. Host, unit, severity, and case-sensitive literal text filters are applied in Loki. Blank text matches all messages. Expand entries for labels, or open Explore for deeper investigation. These filters do not change health charts. Known Qt noise hides only the exact qmlRegisterType requires absolute URLs. message; choose Show all to disable this exclusion. Consecutive identical displayed messages are collapsed. Filtering and deduplication do not delete stored logs or alter error charts. Displayed severity is derived from journal priority, overriding unrecognized detected_level metadata.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 1,
      "options": {
        "dedupStrategy": "exact",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": false
      },
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "{job=\"journal\",host=~\"${host:regex}\",unit=~\"${journal_unit:regex}\",priority=~\"${journal_severity:raw}\"} |= ${journal_search:doublequote} !~ ${journal_noise:doublequote} | label_format level=`{{ if or (eq .priority \"0\") (eq .priority \"1\") }}fatal{{ else if eq .priority \"2\" }}critical{{ else if eq .priority \"3\" }}error{{ else if eq .priority \"4\" }}warn{{ else if or (eq .priority \"5\") (eq .priority \"6\") }}info{{ else if eq .priority \"7\" }}debug{{ else }}unknown{{ end }}`,detected_level=`{{ if or (eq .priority \"0\") (eq .priority \"1\") }}fatal{{ else if eq .priority \"2\" }}critical{{ else if eq .priority \"3\" }}error{{ else if eq .priority \"4\" }}warn{{ else if or (eq .priority \"5\") (eq .priority \"6\") }}info{{ else if eq .priority \"7\" }}debug{{ else }}unknown{{ end }}` | line_format \"{{.host}} \u00b7 {{.unit}} | {{ __line__ }}\"",
          "maxLines": 500,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Fleet journal \u00b7 latest 500 matches",
      "type": "logs"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 11,
      "panels": [],
      "repeat": "host",
      "title": "$host",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "description": "Latest node-exporter scrape result. Up means reachable by Prometheus, not that every service is healthy. Missing data is Unknown.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "Down"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Up"
                }
              },
              "type": "value"
            }
          ],
          "noValue": "Unknown",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 3,
        "x": 0,
        "y": 27
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 14,
          "valueSize": 36
        },
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "up{job=\"node\",host=~\"${host:regex}\"}",
          "instant": true,
          "legendFormat": "{{host}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Status",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "telemetry-prometheus"
      },
      "description": "1 = successful scrapes, 0 = at least one failed scrape in the plotted interval. Uses the minimum over each adaptive interval to preserve brief outages in 7-day and 30-day views. Missing intervals remain gaps. Scrapes are every 30 seconds; unsampled outages cannot be detected. Green marks successful intervals; red marks failed intervals. Thin gray connectors show transitions. Colors use separate filtered series, not a vertical gradient. Only Up intervals have a green area fill; Down remains an unfilled red line at zero.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "gray",
            "mode": "fixed"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "Scrape availability",
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "decimals": 0,
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "custom.hideFrom",
                "value": {
                  "legend": true,
                  "tooltip": true,
                  "viz": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.pointSize",
                "value": 2
              },
              {
                "id": "custom.fillOpacity",
                "value": 15
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.pointSize",
                "value": 2
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 21,
        "x": 3,
        "y": 27
      },
      "id": 6,
      "interval": "30s",
      "maxDataPoints": 4000,
      "options": {
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "min_over_time(up{job=\"node\",host=~\"${host:regex}\"}[$__interval])",
          "instant": false,
          "interval": "30s",
          "legendFormat": "Availability",
          "range": true,
          "refId": "A"
        },
        {
          "expr": "(min_over_time(up{job=\"node\",host=~\"${host:regex}\"}[$__interval])) == 1",
          "instant": false,
          "interval": "30s",
          "legendFormat": "Up",
          "range": true,
          "refId": "B"
        },
        {
          "expr": "(min_over_time(up{job=\"node\",host=~\"${host:regex}\"}[$__interval])) == 0",
          "instant": false,
          "interval": "30s",
          "legendFormat": "Down",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Scrape history",
      "type": "timeseries"
    },
    {
      "id": 17,
      "title": "CPU busy",
      "type": "gauge",
      "description": "CPU non-idle percentage averaged across logical CPUs over the adaptive rate interval, at the selected range end. Includes I/O wait. Not a whole-range average; missing metrics remain Unknown.",
