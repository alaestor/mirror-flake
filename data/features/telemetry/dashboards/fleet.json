    {
      "datasource": {
        "type": "loki",
        "uid": "telemetry-loki"
      },
      "description": "Recurring message shapes, counted across the full selected time range and sorted by volume. Paths, quoted dotted names, UUIDs, hexadecimal IDs and numbers become placeholders; stable wording, source, host, system unit and priority keep classes separate. This is heuristic grouping, not a diagnosis. Click an event family to inspect its exact occurrences in Explore. Overview filters do not change stored logs or alerts. No 500-line sampling or minimum occurrence count. Narrow the host, unit or time range if Loki reports a series limit. Explore opens the whole family without the Message contains or Known noise filters.",
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 1,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Count",
            "desc": true
          }
        ],
        "enablePagination": false,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host,unit,source,priority,event,details) (count_over_time({job=\"journal\",host=~\"${host:regex}\",unit=~\"${journal_unit:regex}\",priority=~\"${journal_severity:raw}\"} |= ${journal_search:doublequote} !~ ${journal_noise:doublequote} | label_format source=\"{{ if .syslog_identifier }}{{ .syslog_identifier }}{{ else if .unit }}{{ .unit }}{{ else }}unknown{{ end }}\",event=\"{{ $event := regexReplaceAll \\\"\\\\\\\\A[ \\\\\\\\t\\\\\\\\r\\\\\\\\n]*(?:[0-9]{1,3}%\\\\\\\\|[ #0-9\u258f\u258e\u258d\u258c\u258b\u258a\u2589\u2588]*\\\\\\\\|[ \\\\\\\\t]*[0-9]+/[0-9]+[ \\\\\\\\t]+\\\\\\\\[[0-9]+(?::[0-9]{2})+<(?:\\\\\\\\?|[0-9]+(?::[0-9]{2})+),[ \\\\\\\\t]*(?:\\\\\\\\?|[0-9]+(?:[.][0-9]+)?)(?:it/s|s/it)\\\\\\\\][ \\\\\\\\t\\\\\\\\r\\\\\\\\n]*)+\\\\\\\\z\\\" (__line__) \\\"Iteration progress output\\\" }}{{ $event = regexReplaceAll \\\"[\\\\\\\\p{C}\\\\\\\\s]+\\\" $event \\\" \\\" }}{{ $event = regexReplaceAll \\\"\\\\\\\\b(?:https?|wss?)://[^\\\\\\\\s\\\\\\\\x22\\\\\\\\x27<>]+\\\" $event \\\"<url>\\\" }}{{ $event = regexReplaceAll \\\"[\\\\\\\\x22\\\\\\\\x27][A-Za-z_][A-Za-z0-9_-]*(?:[.][A-Za-z0-9_-]+)+[\\\\\\\\x22\\\\\\\\x27]\\\" $event \\\"<name>\\\" }}{{ $event = regexReplaceAll \\\"(?:/[A-Za-z0-9_.@%+,:=~${}-]+)+\\\" $event \\\"<path>\\\" }}{{ $event = regexReplaceAll \\\"\\\\\\\\b[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\\\\\\\\b\\\" $event \\\"<id>\\\" }}{{ $event = regexReplaceAll \\\"\\\\\\\\b(?:0x[0-9a-fA-F]+|[0-9a-fA-F]{16,})\\\\\\\\b\\\" $event \\\"<id>\\\" }}{{ $event = regexReplaceAll \\\"\\\\\\\\b[0-9]+(?:[.][0-9]+)*\\\\\\\\b\\\" $event \\\"<n>\\\" }}{{ $event }}\" | label_format details=\"{{ $query := printf \\\"{job=%q,host=%q,unit=%q,priority=%q} %s | source=%q | event=%q\\\" \\\"journal\\\" .host .unit .priority \\\"| label_format source=\\\\\\\"{{ if .syslog_identifier }}{{ .syslog_identifier }}{{ else if .unit }}{{ .unit }}{{ else }}unknown{{ end }}\\\\\\\",event=\\\\\\\"{{ $event := regexReplaceAll \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\A[ \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n]*(?:[0-9]{1,3}%\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\|[ #0-9\u258f\u258e\u258d\u258c\u258b\u258a\u2589\u2588]*\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\|[ \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\t]*[0-9]+/[0-9]+[ \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\t]+\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\[[0-9]+(?::[0-9]{2})+<(?:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\?|[0-9]+(?::[0-9]{2})+),[ \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\t]*(?:\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\?|[0-9]+(?:[.][0-9]+)?)(?:it/s|s/it)\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\][ \\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\t\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\r\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n]*)+\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\z\\\\\\\\\\\\\\\" (__line__) \\\\\\\\\\\\\\\"Iteration progress output\\\\\\\\\\\\\\\" }}{{ $event = regexReplaceAll \\\\\\\\\\\\\\\"[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\p{C}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\s]+\\\\\\\\\\\\\\\" $event \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\" }}{{ $event = regexReplaceAll \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\b(?:https?|wss?)://[^\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\s\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\x22\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\x27<>]+\\\\\\\\\\\\\\\" $event \\\\\\\\\\\\\\\"<url>\\\\\\\\\\\\\\\" }}{{ $event = regexReplaceAll \\\\\\\\\\\\\\\"[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\x22\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\x27][A-Za-z_][A-Za-z0-9_-]*(?:[.][A-Za-z0-9_-]+)+[\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\x22\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\x27]\\\\\\\\\\\\\\\" $event \\\\\\\\\\\\\\\"<name>\\\\\\\\\\\\\\\" }}{{ $event = regexReplaceAll \\\\\\\\\\\\\\\"(?:/[A-Za-z0-9_.@%+,:=~${}-]+)+\\\\\\\\\\\\\\\" $event \\\\\\\\\\\\\\\"<path>\\\\\\\\\\\\\\\" }}{{ $event = regexReplaceAll \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\b[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\b\\\\\\\\\\\\\\\" $event \\\\\\\\\\\\\\\"<id>\\\\\\\\\\\\\\\" }}{{ $event = regexReplaceAll \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\b(?:0x[0-9a-fA-F]+|[0-9a-fA-F]{16,})\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\b\\\\\\\\\\\\\\\" $event \\\\\\\\\\\\\\\"<id>\\\\\\\\\\\\\\\" }}{{ $event = regexReplaceAll \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\b[0-9]+(?:[.][0-9]+)*\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\b\\\\\\\\\\\\\\\" $event \\\\\\\\\\\\\\\"<n>\\\\\\\\\\\\\\\" }}{{ $event }}\\\\\\\"\\\" .source .event }}{{ printf \\\"%q\\\" $query | urlencode }}\" | keep host,unit,source,priority,event,details [$__range]))",
          "queryType": "instant",
          "editorMode": "code"
        }
      ],
      "title": "Fleet \u00b7 event families",
      "type": "table",
      "transformations": [
