      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (host, unit) (count_over_time({job=\"journal\",priority=~\"[0-3]\"} | label_format unit=\"{{ if .unit }}{{ .unit }}{{ else }}unattributed{{ end }}\"[$__auto]))",
          "legendFormat": "{{host}} / {{unit}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Fleet \u00b7 journal errors by source",
      "type": "timeseries"
    },
    {
