{
	admin off
	auto_https off
	persist_config off
}

# Bind loopback without restricting the HTTP Host header: the socket proxy
# preserves the client's collector hostname or address.
http://:@ingressBackendPort@ {
	bind 127.0.0.1
	@push {
		method POST
		path /loki/api/v1/push
	}
	handle @push {
		reverse_proxy http://127.0.0.1:@lokiPort@
	}
	handle /ready {
		reverse_proxy http://127.0.0.1:@lokiPort@
	}
	handle {
		respond 404
	}
}
