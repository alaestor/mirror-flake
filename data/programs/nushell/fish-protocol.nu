def <>< [] {
  echo "           /`-._              " | print
  echo "          /_,.._`:-           " | print
  echo "      ,.-'  ,   ``-:_,-')     " | print
  echo "     : o ):';       _  {      " | print
  echo "      `-._ `'__,.-'\\'\\-.)   " | print
  echo "          `\\\\  \\,.-'``     " | print
}

def ><> [] {
  echo "              _.-'\\          " | print
  echo "           -:'_..,_\\         " | print
  echo "     (`-,_:-'    ,  `-.,      " | print
  echo "      }  _       ;':( o :     " | print
  echo "     (.-'/'/`-.,__' _.-'      " | print
  echo "         `-,./   //`          " | print
}
