+#[test]
+fn routine_hint_row_is_hidden_but_explicit_help_is_preserved() {
+    let mut composer = composer();
+    let options = ComposerRenderOptions {
+        separate_status_line: true,
+        ..Default::default()
+    };
+    assert_eq!(composer.footer_hint_height(100, options), 0);
+    composer.footer.mode = FooterMode::ShortcutOverlay;
+    assert!(composer.footer_hint_height(100, options) > 0);
+    composer.set_status_line_enabled(false);
+    composer.footer.mode = FooterMode::ComposerEmpty;
+    assert!(composer.footer_hint_height(100, options) > 0);
+}
