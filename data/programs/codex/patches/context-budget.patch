+#[tokio::test]
+async fn configured_compaction_budget_uses_live_context_not_session_usage() {
+    let (mut chat, _, _) = make_chatwidget_manual(None).await;
+    chat.config.model_auto_compact_token_limit = Some(176_800);
+    chat.token_info = Some(TokenUsageInfo {
+        total_token_usage: TokenUsage {
+            total_tokens: 900_000,
+            ..Default::default()
+        },
+        last_token_usage: TokenUsage {
+            total_tokens: 88_400,
+            ..Default::default()
+        },
+        model_context_window: Some(272_000),
+    });
+    assert_eq!(
+        chat.status_line_value(StatusLineItem::ContextUsed),
+        Some("ctx 88.4 / 176.8 Kt".to_string())
+    );
+    chat.token_info
+        .as_mut()
+        .unwrap()
+        .last_token_usage
+        .total_tokens = 12_345;
+    assert_eq!(
+        chat.status_line_value(StatusLineItem::ContextUsed),
+        Some("ctx 12.3 / 176.8 Kt".to_string())
+    );
+    chat.token_usage_pending = true;
+    assert_eq!(chat.status_line_value(StatusLineItem::ContextUsed), None);
+}
